# Copy this file to ".env" (in the same folder) and fill it in.
# npm start reads it automatically.

# Required: from your Discord application, https://discord.com/developers/applications
# (OAuth2 page). Also add this redirect there: http://localhost:8080/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: only members of this Discord server can sign in (right-click the server → Copy Server ID)
DISCORD_GUILD_ID=
# Optional: Discord role ids (comma-separated) that make someone a wiki moderator / admin
DISCORD_MOD_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=

# The wiki's address. Must match the redirect above, without /auth/discord/callback.
PUBLIC_URL=http://localhost:8080
PORT=8080

# Where the database and pictures are kept
DATA_DIR=data

# Set to 1 when the wiki runs behind a reverse proxy (nginx, Caddy, Cloudflare)
TRUST_PROXY=
