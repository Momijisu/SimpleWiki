{
  "name": "simplewiki",
  "version": "1.0.0",
  "description": "A self-hosted, multi-user wiki for roleplay communities, with namespaces, templates, themes and moderation.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "backup": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/backup.js",
    "role": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/role.js",
    "demo": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/demo.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js"
  }
}
